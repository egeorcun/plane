# =============================================================================
# PLANE PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# USAGE:
#   1. Copy this file to .env: cp .env.production.example .env
#   2. Generate secure passwords for all [REQUIRED] fields
#   3. Update domain/URL settings
#   4. Run: docker compose -f docker-compose.production.yml up -d --build
#
# COOLIFY USERS:
#   - Variables starting with SERVICE_ are auto-generated by Coolify
#   - Replace ${SERVICE_*} placeholders with Coolify's service variables
#   - Or set your own values directly
#
# =============================================================================

# =============================================================================
# [REQUIRED] SECURITY SETTINGS
# =============================================================================
# These MUST be changed from default values for production!

# Django Secret Key - Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# [REQUIRED] Minimum 50 characters
SECRET_KEY=

# Allowed hosts - Your domain(s), comma-separated
# [REQUIRED] Do NOT use * in production!
# Example: plane.example.com,www.plane.example.com
ALLOWED_HOSTS=

# CORS allowed origins - Your frontend URL(s)
# [REQUIRED] Must match your WEB_URL
# Example: https://plane.example.com
CORS_ALLOWED_ORIGINS=

# Debug mode - MUST be 0 in production
DEBUG=0

# =============================================================================
# [REQUIRED] DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL credentials
POSTGRES_USER=plane
# [REQUIRED] Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=plane

# =============================================================================
# [REQUIRED] MESSAGE QUEUE CONFIGURATION  
# =============================================================================

# RabbitMQ credentials
RABBITMQ_USER=plane
# [REQUIRED] Generate a strong password: openssl rand -base64 32
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=plane
RABBITMQ_PORT=5672

# =============================================================================
# [REQUIRED] OBJECT STORAGE CONFIGURATION
# =============================================================================

# MinIO / S3 credentials
# [REQUIRED] Generate unique access keys
# For MinIO: openssl rand -hex 16
AWS_ACCESS_KEY_ID=
# [REQUIRED] Generate unique secret keys
# For MinIO: openssl rand -hex 32
AWS_SECRET_ACCESS_KEY=

# S3 settings (for MinIO, keep defaults)
AWS_REGION=
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads

# Use MinIO (set to 0 if using external S3)
USE_MINIO=1
MINIO_ENDPOINT_SSL=0

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Your Plane instance URL (with protocol)
# Example: https://plane.example.com
WEB_URL=http://localhost

# Application version tag
APP_RELEASE=v1.0.0

# Gunicorn workers (2 * CPU cores + 1 recommended)
GUNICORN_WORKERS=2

# Maximum file upload size in bytes (default: 5MB)
FILE_SIZE_LIMIT=5242880

# API rate limiting
API_KEY_RATE_LIMIT=60/minute

# =============================================================================
# NETWORK SETTINGS
# =============================================================================

# Ports to expose (change if conflicts exist)
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# Redis settings (internal, don't change unless using external Redis)
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# =============================================================================
# SSL/TLS SETTINGS (Optional - for automatic HTTPS)
# =============================================================================

# Let's Encrypt ACME server
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Trusted proxies for X-Forwarded-* headers
TRUSTED_PROXIES=0.0.0.0/0

# Email for SSL certificate notifications
CERT_EMAIL=

# DNS challenge for wildcard certificates (optional)
CERT_ACME_DNS=

# =============================================================================
# COOLIFY-SPECIFIC VARIABLES
# =============================================================================
# If using Coolify, you can use these auto-generated variables:
#
# SECRET_KEY=${SERVICE_PASSWORD_64_SECRETKEY}
# POSTGRES_USER=${SERVICE_USER_POSTGRES}
# POSTGRES_PASSWORD=${SERVICE_PASSWORD_POSTGRES}
# RABBITMQ_USER=${SERVICE_USER_RABBITMQ}
# RABBITMQ_PASSWORD=${SERVICE_PASSWORD_RABBITMQ}
# AWS_ACCESS_KEY_ID=${SERVICE_USER_MINIO}
# AWS_SECRET_ACCESS_KEY=${SERVICE_PASSWORD_MINIO}
# WEB_URL=${SERVICE_URL_PLANE}
# CORS_ALLOWED_ORIGINS=${SERVICE_URL_PLANE}
# ALLOWED_HOSTS=${SERVICE_FQDN_PLANE}
#
# =============================================================================

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying, verify:
#
# [ ] SECRET_KEY is set (50+ characters)
# [ ] ALLOWED_HOSTS contains your domain(s) only
# [ ] CORS_ALLOWED_ORIGINS matches your frontend URL
# [ ] DEBUG=0
# [ ] POSTGRES_PASSWORD is strong and unique
# [ ] RABBITMQ_PASSWORD is strong and unique  
# [ ] AWS_ACCESS_KEY_ID is unique
# [ ] AWS_SECRET_ACCESS_KEY is strong and unique
# [ ] WEB_URL is your actual domain with https://
# [ ] SSL/TLS is configured (CERT_EMAIL set or external proxy)
# [ ] Firewall only exposes ports 80/443
# [ ] Database backups are configured
#
# =============================================================================
