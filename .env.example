# =============================================================================
# PLANE ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT SECURITY NOTES:
# 1. This file contains example values for LOCAL DEVELOPMENT ONLY
# 2. NEVER use these default values in production
# 3. Generate strong, unique passwords and keys for production deployment
# 4. Review all settings before deploying to production
# =============================================================================

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# [SECURITY] Change these credentials in production!
# Default values are for local development only
POSTGRES_USER="plane"
# [SECURITY] CHANGE THIS! Use a strong, unique password (32+ characters recommended)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD="plane"
POSTGRES_DB="plane"
PGDATA="/var/lib/postgresql/data"

# =============================================================================
# REDIS SETTINGS
# =============================================================================
REDIS_HOST="plane-redis"
REDIS_PORT="6379"

# =============================================================================
# RABBITMQ SETTINGS
# =============================================================================
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
# [SECURITY] CHANGE THIS! Use a strong, unique password
# Default 'plane' or 'guest' passwords are insecure for production
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# =============================================================================
# NETWORK SETTINGS
# =============================================================================
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# =============================================================================
# AWS/MINIO SETTINGS (Object Storage)
# =============================================================================
AWS_REGION=""
# [SECURITY] CHANGE THESE! Default values are insecure
# For MinIO: Generate unique access keys
# For AWS S3: Use IAM credentials with minimal required permissions
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit in bytes (default: 5MB)
FILE_SIZE_LIMIT=5242880

# =============================================================================
# GPT SETTINGS (Deprecated)
# =============================================================================
OPENAI_API_BASE="https://api.openai.com/v1" # deprecated
OPENAI_API_KEY="sk-" # deprecated
GPT_ENGINE="gpt-3.5-turbo" # deprecated

# =============================================================================
# DOCKER SETTINGS
# =============================================================================
DOCKERIZED=1  # deprecated

# Set to 1 if using the pre-configured MinIO setup
USE_MINIO=1

# =============================================================================
# SSL/TLS CERTIFICATE SETTINGS
# =============================================================================
# Automatic SSL certificate generation using Let's Encrypt
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
# Set your email for certificate notifications
CERT_EMAIL=

# For DNS Challenge based certificate generation
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# =============================================================================
# RATE LIMITING
# =============================================================================
# API key rate limit (requests per time period)
API_KEY_RATE_LIMIT="60/minute"

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure you have:
# [ ] Changed POSTGRES_PASSWORD to a strong, unique value
# [ ] Changed RABBITMQ_PASSWORD to a strong, unique value
# [ ] Changed AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# [ ] Set up SSL/TLS certificates (CERT_EMAIL configured)
# [ ] Configured proper firewall rules
# [ ] Set ALLOWED_HOSTS to your specific domain(s) in API settings
# [ ] Set a strong SECRET_KEY in API settings
# [ ] Verified DEBUG=0 in API settings
# [ ] Reviewed and restricted CORS_ALLOWED_ORIGINS
# =============================================================================
