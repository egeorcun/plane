# =============================================================================
# PLANE API ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT SECURITY NOTES:
# 1. This file contains example values for LOCAL DEVELOPMENT ONLY
# 2. NEVER use these default values in production
# 3. All values marked with [SECURITY] MUST be changed for production
# 4. The application will refuse to start in production mode if critical
#    security settings are not properly configured
# =============================================================================

# =============================================================================
# CRITICAL SECURITY SETTINGS
# =============================================================================
# [SECURITY] REQUIRED: Generate a strong, unique secret key
# The application will NOT start in production without this
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=""

# [SECURITY] REQUIRED: Set your specific domain(s) for production
# Using "*" is NOT allowed in production and will cause startup failure
# Example: "example.com,www.example.com,api.example.com"
ALLOWED_HOSTS="localhost,127.0.0.1"

# =============================================================================
# DEBUG SETTINGS
# =============================================================================
# [SECURITY] MUST be 0 in production! Setting DEBUG=1 in production will
# cause the application to refuse to start
# Debug value for api server: 0 for production, 1 for development only
DEBUG=0

# =============================================================================
# CORS SETTINGS
# =============================================================================
# [SECURITY] In production, specify only your frontend domain(s)
# Do not use wildcards or allow all origins in production
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
POSTGRES_USER="plane"
# [SECURITY] CHANGE THIS! Use a strong, unique password (32+ characters recommended)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS SETTINGS
# =============================================================================
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# =============================================================================
# RABBITMQ SETTINGS
# =============================================================================
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
# [SECURITY] CHANGE THIS! Default 'plane' or 'guest' passwords are insecure
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# =============================================================================
# AWS/MINIO SETTINGS (Object Storage)
# =============================================================================
AWS_REGION=""
# [SECURITY] CHANGE THESE! Default values are insecure for production
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit in bytes (default: 5MB)
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# =============================================================================
# DOCKER SETTINGS
# =============================================================================
DOCKERIZED=1 # deprecated

# Set to 1 if using the pre-configured MinIO setup
USE_MINIO=0

# =============================================================================
# URL SETTINGS
# =============================================================================
# Email redirections and minio domain settings
# [SECURITY] Set to your actual domain in production (with https://)
WEB_URL="http://localhost:8000"

# Gunicorn Workers (adjust based on your server's CPU cores)
GUNICORN_WORKERS=2

# Base URLs for different services
# [SECURITY] Update these to your production URLs with https://
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

# [SECURITY] CHANGE THIS! Use a strong, unique key for live server
LIVE_SERVER_SECRET_KEY="secret-key"

# =============================================================================
# DATA RETENTION
# =============================================================================
# Hard delete files after days (default: 60)
HARD_DELETE_AFTER_DAYS=60

# =============================================================================
# SSL/MINIO SETTINGS
# =============================================================================
# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# =============================================================================
# RATE LIMITING
# =============================================================================
# API key rate limit (requests per time period)
API_KEY_RATE_LIMIT="60/minute"

# =============================================================================
# OPTIONAL: Skip security validation (NOT RECOMMENDED FOR PRODUCTION)
# =============================================================================
# Set to 1 ONLY for CI/CD testing or local development
# NEVER set this in production - it disables critical security checks
# SKIP_SECURITY_VALIDATION=0

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure you have:
#
# CRITICAL (Application will not start without these):
# [ ] Set SECRET_KEY to a strong, unique value (50+ characters)
# [ ] Set ALLOWED_HOSTS to your specific domain(s) (not "*")
# [ ] Set DEBUG=0
#
# IMPORTANT (Application will warn if not set):
# [ ] Changed POSTGRES_PASSWORD to a strong, unique value
# [ ] Changed RABBITMQ_PASSWORD to a strong, unique value  
# [ ] Changed AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# [ ] Changed LIVE_SERVER_SECRET_KEY to a strong, unique value
#
# RECOMMENDED:
# [ ] Configured CORS_ALLOWED_ORIGINS with only your frontend domain(s)
# [ ] Set all *_BASE_URL variables to https:// URLs
# [ ] Set MINIO_ENDPOINT_SSL=1 if using HTTPS for MinIO
# [ ] Reviewed GUNICORN_WORKERS based on your server's resources
# [ ] Set up proper log monitoring
# [ ] Configured backup strategy for database
# =============================================================================
